use Illuminate\Support\Str;

/*
|--------------------------------------------------------------------------
| Example 1: unpersisted model instance with a valid primary key
|--------------------------------------------------------------------------
| Only needed if the app uses UUID/ULID primary keys AND some code under
| test needs a model instance that has a valid key WITHOUT being saved
| (e.g. a pivot-attach method called with an in-memory user). Adjust the
| model class and primary key strategy to match the real app.
*/
function modelWithUuid(string $class): object
{
    $model = new $class();
    $model->forceFill(['id' => (string) Str::uuid()]); // forceFill: bypasses $fillable

    return $model;
}

